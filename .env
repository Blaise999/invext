# ---- Required -------------------------------------------------------------

# Signs sessions and keys the OTP HMAC. 32+ chars.
# Generate with:  openssl rand -hex 32
AUTH_SECRET=

# Resend. Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Must be a domain verified in your Resend dashboard, or mail silently vanishes.
EMAIL_FROM="InveXt <security@yourdomain.com>"

# ---- Optional -------------------------------------------------------------

EMAIL_REPLY_TO="support@yourdomain.com"

# Used to build the dashboard link in the welcome email.
APP_URL="http://localhost:3000"

# DATA_DIR is gone. Everything that used to live in the JSON file is in
# Postgres now — see supabase/migrations/0005 and 0006.

# ---- Supabase --------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://omknqjbtgzryohrazago.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9ta25xamJ0Z3pyeW9ocmF6YWdvIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NzE1MjY3OSwiZXhwIjoyMTAyNzI4Njc5fQ.k8NUlxWj07AkQ9YIa_vx3YAn1ihRbT-VmUMnOGAplmo       # service_role, not anon
ADMIN_NAME=Benneth
ADMIN_EMAIL=benneth@invext.com     # must be an inbox you can open
ADMIN_PASSWORD=09130827339bs

ADMIN_SKIP_OTP=1
# Server only. Bypasses RLS — never expose to the browser, never prefix
# with NEXT_PUBLIC_.
#
# REQUIRED. Every server-side read and write goes through this key: OTP
# challenges, sessions, the ledger, positions, marks, addresses, notifications
# and the audit log are all service-role only. Without it, signup returns 500,
# nobody can sign in, and every balance reads as zero.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Deposit webhook -------------------------------------------------------

# Shared secret your payment processor signs webhook bodies with.
# Without this the endpoint rejects every request, which is the safe default.
DEPOSIT_WEBHOOK_SECRET=

# Comma-separated emails allowed into /admin.
# Temporary bridge until auth moves to Supabase and has_role() takes over.
ADMIN_EMAILS=you@yourdomain.com

# ---- Market data -----------------------------------------------------------
#
# ALPACA IS THE ONE TO SET. Free "Basic" plan, no card required:
#   https://alpaca.markets  ->  sign up  ->  Paper trading  ->  API keys
#
# Why this and not Finnhub: Alpaca serves QUOTES AND DAILY BARS, and it batches
# — all 40 symbols on the board resolve in two requests instead of forty. The
# free Finnhub tier gives you a price but NOT history (/stock/candle is paid),
# which is why the charts stayed empty even with a Finnhub key set.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Optional. Free plans get the IEX feed; leave unset unless you pay for SIP.
# ALPACA_FEED=iex
# ALPACA_DATA_URL=https://data.alpaca.markets

# Fallback. Quotes only on the free tier — history comes back empty, and the
# chart then draws a *derived* shape labelled as such under the plot.
# Free tier, 60 calls/min — https://finnhub.io/register
FINNHUB_API_KEY=

# Optional. Improves logo coverage for the 12 PRIVATE companies, which have
# no ticker for the ticker-keyed logo services to look up.
# Publishable token, free: https://logo.dev
NEXT_PUBLIC_LOGODEV_TOKEN=

# ---- Company identity ------------------------------------------------------
# Rendered in the footer and the disclosure. Any left unset is omitted rather
# than shown as a placeholder. Do not invent a registration number.
COMPANY_LEGAL_NAME=
COMPANY_REGISTRATION=
COMPANY_EMAIL=
COMPANY_ADDRESS=

# ---- Super-admin bootstrap --------------------------------------------------
# Used once by `npm run admin`, which creates the account and grants the admin
# role in public.user_roles. Keep these here, not in source: this account can
# adjust balances and approve withdrawals, a password in the repo is in every
# clone and every CI log, and it can't be rotated without a deploy.
ADMIN_NAME=Benneth
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Fallback gate for a project that hasn't run the bootstrap yet. Comma
# separated. The role table wins when both are present.
ADMIN_EMAILS=

# ---- Preview build ----------------------------------------------------------
# Fills anything that would render blank with illustrative figures, and shows a
# strip at the top of the page plus a dot on every affected number saying so.
# Use it for demos and pitches. Leave it unset for anything live.
NEXT_PUBLIC_PREVIEW=1

# ---- Demo mode --------------------------------------------------------------
# Loads a fictional populated dashboard so you can see the UI without a database.
# OFF in production unless ALLOW_DEMO_IN_PROD=1. Leave it off.
DEMO_ACCESS_CODE=2304
# ALLOW_DEMO_IN_PROD=1

# ---- Dev OTP bypass ---------------------------------------------------------
# Accepts this exact 6-digit code at the verify step, alongside the real emailed
# one, so you can sign in before Resend is configured.
#
# Off unless set, and refuses to run in production unless you also set
# ALLOW_DEV_OTP_IN_PROD=1. Delete both before launch.
DEV_OTP_CODE=123456
# ALLOW_DEV_OTP_IN_PROD=1
